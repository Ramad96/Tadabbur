# Copy to .env.local and fill in. Never commit .env.local.
# Both values are public by design (the anon key is safe in the browser; RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: used by scripts (type generation, seeding, RLS tests). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
